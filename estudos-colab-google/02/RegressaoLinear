{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"toc_visible":true,"authorship_tag":"ABX9TyOw6zSsAJudjKYIEc6Rn5tY"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":[],"metadata":{"id":"V50L88kkQNI0"}},{"cell_type":"code","source":["from numpy import *\n","\n","class RegressaoLinear:\n","\n","  def __init__(self, x, y):\n","    self.x = x\n","    self.y = y\n","    self.__valor_correlacao = self.__correlacao()\n","    self.__valor_inclinacao = self.__inclinacao()\n","    self.__valor_interceptacao = self.__interceptacao()\n","\n","\n","  def __correlacao(self) :\n","    covariacao = cov(self.x, self.y, bias=True)[0][1]\n","    varianca_x = var(self.x)\n","    varianca_y = var(self.y)\n","    return covariacao / sqrt(varianca_x * varianca_y)\n","\n","  def __inclinacao(self) :\n","    std_x = std(self.x)\n","    std_y = std(self.y)\n","    return self.__valor_correlacao * (std_y / std_x)\n","\n","  def __interceptacao(self) :\n","    media_x = mean(self.x)\n","    media_y = mean(self.y)\n","    return media_y - media_x * self.__valor_inclinacao\n","\n","  def previsao(self, valor):\n","    return self.__valor_interceptacao + self.__valor_inclinacao * valor"],"metadata":{"id":"CZdB-qQ2MkP6","executionInfo":{"status":"ok","timestamp":1770839790073,"user_tz":180,"elapsed":11,"user":{"displayName":"Luciano Ortiz","userId":"06170887622077290696"}}},"execution_count":13,"outputs":[]},{"cell_type":"code","source":["x = array([1,2,3,4,5])\n","y = array([2,4,6,8,10])\n","\n","rl = RegressaoLinear(x, y)\n","valor_previsto = rl.previsao(6)\n","print(valor_previsto)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"o7BC7IuCNz88","executionInfo":{"status":"ok","timestamp":1770839792036,"user_tz":180,"elapsed":8,"user":{"displayName":"Luciano Ortiz","userId":"06170887622077290696"}},"outputId":"34c8c9c8-a02b-44df-d700-4b5c84bd422b"},"execution_count":14,"out